generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String            @id @default(cuid())
  username               String?           @unique
  email                  String?           @unique
  phone                  String?           @unique @db.VarChar(10)
  dob                    DateTime?
  address                String?
  profilePic             String?
  isVerified             Boolean           @default(false)
  isBlocked              Boolean           @default(false)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?
  freeCallMinutes        Int               @default(5)
  freeCallPopupShown     Boolean           @default(false)
  hasCompletedOnboarding Boolean           @default(false)
  houseNo                String?
  image                  String?
  isProfileCompleted     Boolean           @default(false)
  landmark               String?
  name                   String?
  pinCode                String?           @db.VarChar(6)
  provider               AuthProvider      @default(PHONE)
  gender                 Gender?
  bookings               Booking[]
  calls                  Call[]
  devices                Device[]
  freeCallUsage          FreeCallUsage?
  otpRequests            OTPVerification[]
  orders                 Order[]
  sessions               Session[]
  transactions           Transaction[]
  userHoroscope          UserHoroscope?
  plans                  UserPlan[]
  wallet                 Wallet?
  communityJoin CommunityJoin?

  @@index([phone])
  @@index([email])
}
model CommunityJoin {
  id        String   @id @default(cuid())
  userId    String   @unique
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTPVerification {
  id         String   @id @default(cuid())
  identifier String
  otp        String
  attempts   Int      @default(0)
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
}

model Booking {
  id                String        @id @default(cuid())
  userId            String
  bookingId         String?       @unique
  poojaId           Int
  poojaTitle        String
  poojaType         PoojaType     @default(OFFLINE) // ONLINE or OFFLINE
  poojaImage        String?
  duration          String?
  amount            Int
  originalPrice     Int?
  discount          Int?
  customerName      String
  customerPhone     String        @db.VarChar(10)
  customerEmail     String
  houseNo           String?
  address           String?
  landmark          String?
  pinCode           String?       @db.VarChar(6)
  scheduledDate     String
  scheduledTime     String?
  status            BookingStatus @default(PENDING) // PENDING, CONFIRMED, COMPLETED, CANCELLED
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  specialRequests   String?
  panditNotes       String?

  // ✅ NEW FIELDS FOR ONLINE POOJAS
  videoLink                   String? // Video link after completion
  certificateUrl              String? // Generated certificate PDF URL
  certificateVerificationCode String? @unique @default(cuid()) // Unique code for certificate

  // ✅ NEW FIELDS FOR REMINDERS
  remindersScheduled Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[] // ✅ ADD THIS

  @@index([userId])
  @@index([status])
  @@index([scheduledDate])
  @@index([poojaType])
}

model Reminder {
  id            String       @id @default(cuid())
  bookingId     String
  reminderType  ReminderType // CONFIRMATION, ONE_DAY_BEFORE, ONE_HOUR_BEFORE
  scheduledTime DateTime
  sent          Boolean      @default(false)
  sentAt        DateTime?
  sentVia       String       @default("WHATSAPP") // WHATSAPP, EMAIL, SMS
  errorMessage  String?
  retryCount    Int          @default(0)
  maxRetries    Int          @default(3)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, reminderType]) // One reminder per type per booking
  @@index([bookingId])
  @@index([scheduledTime])
  @@index([sent])
}

model FreeCallUsage {
  id     String   @id @default(cuid())
  userId String   @unique
  callId String
  usedAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String   @unique
  platform   String
  ip         String?
  userAgent  String?
  lastActive DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  balance      Float         @default(0)
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  user         User          @relation(fields: [userId], references: [id])
}

model Transaction {
  id                String        @id @default(cuid())
  userId            String
  walletId          String?
  amount            Float
  type              String
  purpose           String
  status            PaymentStatus
  razorpayOrderId   String?
  razorpayPaymentId String?
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())
  callBillings      CallBilling[]
  user              User          @relation(fields: [userId], references: [id])
  wallet            Wallet?       @relation(fields: [walletId], references: [id])
}

model PaymentLog {
  id        String   @id @default(cuid())
  event     String
  payload   Json
  createdAt DateTime @default(now())
}

model Call {
  id              String         @id @default(cuid())
  userId          String?
  panditId        String
  channelName     String
  agoraToken      String?
  type            String
  deletedUsername String?
  billingType     BillingType    @default(PLAN)
  ratePerMinute   Float          @default(0)
  isFreeCall      Boolean        @default(false)
  freeSeconds     Int            @default(0)
  paidSeconds     Int            @default(0)
  status          CallStatus     @default(INITIATED)
  startTime       DateTime?
  endTime         DateTime?
  duration        Int?
  billableSeconds Int?
  totalCost       Float?         @default(0)
  autoEnded       Boolean        @default(false)
  endedBy         String?
  createdAt       DateTime       @default(now())
  callLiveStateId String?
  liveState       CallLiveState? @relation(fields: [callLiveStateId], references: [id])
  pandit          Pandit         @relation(fields: [panditId], references: [id])
  user            User?          @relation(fields: [userId], references: [id])
  billing         CallBilling?
  events          CallEvent[]
}

model Pandit {
  id                                String    @id @default(cuid())
  name                              String
  username                          String    @unique
  password                          String
  email                             String?
  phone                             String?
  dob                               DateTime?
  about                             String?
  speciality                        String[]
  languages                         String[]
  profilePic                        String?
  profilePicPublicId                String?
  startTime                         String    @default("09:00")
  endTime                           String    @default("21:00")
  breakTime                         String    @default("13:00")
  workingDays                       String[]  @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"])
  notificationsConsultationRequests Boolean   @default(true)
  notificationsMessages             Boolean   @default(true)
  notificationsReminders            Boolean   @default(true)
  notificationsPromotions           Boolean   @default(false)
  ratePerMin                        Float     @default(0)
  isAvailable                       Boolean   @default(true)
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt
  fcmToken                          String?
  calls                             Call[]
}

model CallEvent {
  id        String   @id @default(cuid())
  callId    String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id])

  @@index([callId])
}

model CallBilling {
  id              String       @id @default(cuid())
  callId          String       @unique
  totalDuration   Int
  chargedDuration Int
  totalCost       Float
  freeMinutesUsed Int          @default(0)
  walletDeducted  Float        @default(0)
  planUsedMinutes Int          @default(0)
  transactionId   String?
  createdAt       DateTime     @default(now())
  call            Call         @relation(fields: [callId], references: [id])
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
}

model CallLiveState {
  id          String   @id @default(cuid())
  callId      String   @unique
  currentCost Float    @default(0)
  elapsedSec  Int      @default(0)
  lastSynced  DateTime @default(now())
  calls       Call[]
}

model CallAlert {
  id        String   @id @default(cuid())
  callId    String
  type      String
  createdAt DateTime @default(now())
}

model Plan {
  id          String     @id @default(cuid())
  name        String
  price       Int
  seconds     Int
  validDays   Int
  planType    PlanType   @default(MONTHLY)
  perDayLimit Int?
  includes    String[]
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  userPlans   UserPlan[]
}

model UserPlan {
  id                String    @id @default(cuid())
  userId            String
  planId            String
  remainingSeconds  Int
  perDayUsedSeconds Int       @default(0)
  lastUsedDate      DateTime?
  startDate         DateTime  @default(now())
  endDate           DateTime
  isActive          Boolean   @default(true)
  plan              Plan      @relation(fields: [planId], references: [id])
  user              User      @relation(fields: [userId], references: [id])
}

model Product {
  id               String               @id @default(cuid())
  title            String
  shortDescription String?
  description      String?
  longDescription  String?
  category         String
  price            Float
  originalPrice    Float?
  rating           Float?               @default(0)
  reviews          Int                  @default(0)
  image            String?
  images           String[]
  inStock          Boolean              @default(true)
  isActive         Boolean              @default(true)
  benefits         String[]
  tags             String[]             @default([]) // ✅ for filter tags
  specifications   Json? // flexible key-value
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  orderItems       OrderItem[]
  testimonials     ProductTestimonial[]

  @@index([category])
  @@index([isActive])
  @@index([tags])
}

model ProductTestimonial {
  id        String   @id @default(cuid())
  productId String
  name      String
  location  String?
  rating    Int      @default(5)
  text      String
  date      DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model pooja_testimonials {
  id         Int      @id @default(autoincrement())
  pooja_id   Int
  name       String   @db.VarChar(150)
  location   String?  @db.VarChar(150)
  rating     Int      @default(5)
  text       String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  poojas poojas @relation(fields: [pooja_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pooja_id], map: "idx_pooja_testimonials_pooja_id")
}

// ── NEW MODEL ────────────────────────────────────────────────
model pooja_content {
  id                    Int      @id @default(autoincrement())
  pooja_id              Int      @unique

  // Hero
  hero_subtitle         String?  @db.Text
  hero_access           String?  @db.VarChar(50)   // e.g. "Live"
  hero_benefits         Json?                       // ["Peace & Harmony", "Prosperity"]

  // About + Live Experience
  about_title           String?  @db.VarChar(255)
  about_content         String?  @db.Text
  live_title            String?  @db.VarChar(255)
  live_content          String?  @db.Text

  // How It Works
  how_it_works          Json?    // [{ step:"01", title:"", description:"" }]

  // What Happens During Pooja
  process_intro         String?  @db.Text
  process_steps         Json?    // [{ title:"", description:"" }]

  // What To Prepare
  preparation_note      String?  @db.Text
  preparation_required  Json?    // ["A quiet clean space", ...]
  preparation_optional  Json?    // ["A diya", ...]

  // Cultural Roots
  cultural_title        String?  @db.VarChar(255)
  cultural_story        String?  @db.Text
  cultural_chapters     Json?    // [{ chapter:1, title:"", description:"" }]
  cultural_closing      String?  @db.Text

  // FAQs
  faqs                  Json?    // [{ question:"", answer:"" }]

  // Closing CTA
  closing_title         String?  @db.VarChar(255)
  closing_description   String?  @db.Text
  closing_tags          Json?    // ["Live Katha", "Personalized Sankalp"]

  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)

  poojas poojas @relation(fields: [pooja_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pooja_id], map: "idx_pooja_content_pooja_id")
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  orderId     String      @unique @default(cuid())
  totalAmount Float
  status      OrderStatus @default(PENDING)

  // Delivery Address
  houseNo     String?
  address     String?
  landmark    String?
  pinCode     String? @db.VarChar(6)
  latitude    Float?
  longitude   Float?
  addressType String?
  fullAddress String  @default("")

  // Customer Details
  customerName  String @default("")
  customerPhone String @default("") @db.VarChar(10)
  customerEmail String @default("")

  // Product Details
  productId    String?
  productTitle String?
  productImage String?
  quantity     Int?
  unitPrice    Float?

  // Payment Details
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  paymentStatus     PaymentStatus @default(PENDING)

  // Additional
  specialRequests   String?
  deliveryStatus    DeliveryStatus @default(PENDING)
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  shuddhikaranRequested Boolean @default(false)
  shuddhikaranAmount    Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  deliveries Delivery[] // ✅ Add this relation

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  quantity  Int
  price     Float
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

model DeliveryPartner {
  id          String     @id @default(cuid())
  name        String
  phone       String
  vehicleType String
  isAvailable Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  deliveries  Delivery[]
}

model Delivery {
  id          String    @id @default(cuid())
  orderId     String
  partnerId   String
  status      String    @default("ASSIGNED")
  assignedAt  DateTime  @default(now())
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([partnerId])
  @@index([status])
}

model FeatureFlag {
  id      String  @id @default(cuid())
  key     String  @unique
  enabled Boolean @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}

model DailyHoroscope {
  id        String   @id @default(cuid())
  date      DateTime @unique
  content   Json
  source    String   @default("CALCULATED")
  accuracy  Float    @default(0.8)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model HoroscopeSource {
  id          String    @id @default(cuid())
  name        String    @unique
  url         String?
  apiKey      String?
  sourceType  String
  isActive    Boolean   @default(true)
  lastFetched DateTime?
  reliability Float     @default(0.7)
  createdAt   DateTime  @default(now())
}

model PlanetaryTransit {
  id           String   @id @default(cuid())
  date         DateTime
  planetName   String
  longitude    Float
  sign         String
  degree       Float
  speed        Float
  isRetrograde Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([date, planetName])
  @@index([date, planetName])
}

model HoroscopeCache {
  id          String   @id @default(cuid())
  rashi       String
  period      String
  dateKey     String
  data        Json
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@unique([rashi, period, dateKey])
  @@index([period, dateKey])
  @@index([expiresAt])
}

model HoroscopeGenerationLog {
  id          String   @id @default(cuid())
  period      String
  dateKey     String
  totalRashis Int
  apiCalls    Int
  status      String   @default("SUCCESS")
  completedAt DateTime @default(now())

  @@unique([period, dateKey])
  @@index([period, completedAt])
}

model UserHoroscope {
  id          String   @id @default(cuid())
  userId      String   @unique
  birthDate   DateTime
  birthTime   String?
  birthPlace  String?
  latitude    Float?
  longitude   Float?
  sunSign     String
  moonSign    String?
  ascendant   String?
  lastUpdated DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PanchangFestival {
  id                  Int       @id @default(autoincrement())
  year                Int       @default(2026)
  month               String    @db.VarChar(20)
  festivalName        String    @map("festival_name") @db.VarChar(100)
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  muhurat             String    @db.VarChar(255)
  importantDetails    String    @map("important_details")
  laabhOfPooja        String    @map("laabh_of_pooja")
  filter              String    @db.VarChar(100)
  recommendedPujaType String    @map("recommended_puja_type") @db.VarChar(255)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("panchang_festivals")
}

model SystemState {
  id        String   @id
  key       String   @unique
  value     Json
  updatedAt DateTime
  createdAt DateTime @default(now())
}

model pooja_languages {
  id       Int     @id @default(autoincrement())
  pooja_id Int?
  language String  @db.VarChar(50)
  poojas   poojas? @relation(fields: [pooja_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pooja_id], map: "idx_pooja_languages_pooja_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model poojas {
  id                 Int                  @id @default(autoincrement())
  title              String               @db.VarChar(255)
  short_description  String?
  description        String?
  price              Decimal              @db.Decimal(10, 2)
  offer_price        Decimal              @db.Decimal(10, 2)
  duration           String?              @db.VarChar(100)
  mode               String               @db.VarChar(50)
  image              String?              @db.VarChar(500)
  rating             Decimal?             @default(0) @db.Decimal(3, 2)
  bookings           String?              @default("0") @db.VarChar(50)
  popular            Boolean?             @default(false)
  category           String               @db.VarChar(20)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  filter             String?              @db.VarChar(100)
  pooja_languages    pooja_languages[]
  pooja_testimonials pooja_testimonials[]
   pooja_content      pooja_content? 

  @@index([category], map: "idx_poojas_category")
  @@index([popular], map: "idx_poojas_popular")
}

model CalendarAvailability {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  isAvailable Boolean  @default(true)
  timeSlots   Json // Remove default, handle in code
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([isAvailable])
}

enum CallStatus {
  INITIATED
  RINGING
  ONGOING
  COMPLETED
  FAILED
}

enum PlanType {
  TOPUP
  MONTHLY
  YEARLY
}

enum BillingType {
  FREE
  PLAN
  WALLET
}

enum PoojaMode {
  VIDEO_CALL
  AT_HOME
}

enum TimeSlot {
  SLOT_8_12
  SLOT_12_15
  SLOT_15_19
  SLOT_19_22
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FEEDBACK
  COMPLETED
  CANCELLED
}

enum ReminderType {
  CONFIRMATION // Immediate after booking
  ONE_DAY_BEFORE // Day before at 8 AM
  MORNING_OF_POOJA // Morning of pooja at 8 AM
  ONE_HOUR_BEFORE // 1 hour before pooja
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  PAID
  REFUNDED
}

enum AuthProvider {
  PHONE
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PoojaType {
  ONLINE
  OFFLINE
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  fromNumber  String // customer's phone number
  messageText String
  bookingId   String? // matched booking, if any
  waMessageId String?  @unique // Meta's message ID, prevents duplicate webhook processing
  receivedAt  DateTime @default(now())

  @@index([fromNumber])
  @@index([bookingId])
  @@index([receivedAt])
}
