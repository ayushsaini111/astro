{
  "functions": {
    "src/app/api/horoscope/cron/route.js": {
      "maxDuration": 180
    }
  },
  "crons": [
    {
      "path": "/api/horoscope/cron?secret=your_super_secret_cron_key_here&period=daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/horoscope/cron?secret=your_super_secret_cron_key_here&period=weekly",
      "schedule": "3 0 * * 0"
    },
    {
      "path": "/api/horoscope/cron?secret=your_super_secret_cron_key_here&period=monthly",
      "schedule": "6 0 1 * *"
    },
    {
      "path": "/api/horoscope/cron?secret=your_super_secret_cron_key_here&period=yearly",
      "schedule": "12 0 1 1 *"
    }
  ]
}